# Anthropic API key used by the LLM candidate source.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Optional overrides
# XWORD_MODEL="claude-sonnet-5"        # model used for the main clue-reading pass
# XWORD_HARD_MODEL="claude-opus-5"     # escalate re-asked clues to a stronger model.
#                                      # Off by default: it roughly doubles cost per solve.
# XWORD_CACHE_DIR=".xword-cache"       # persistent clue cache (makes re-runs free)
# XWORD_DATA_DIR="data"
# XWORD_REPORT_DIR="reports"
